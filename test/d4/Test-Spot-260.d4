      <Attribute ID="Pan" ChannelOffset="0"/>
      <Attribute ID="Tilt" ChannelOffset="1"/>
      <Attribute ID="Colour" ChannelOffset="2"/>
      <Attribute ID="Gobo1" ChannelOffset="3"/>
      <Attribute ID="Shutter" ChannelOffset="5"/>
