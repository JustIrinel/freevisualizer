    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Group="B">
      <Function Name="Zoom" Dmx="0~255"/>
    </Attribute>
  </Control>
  <Mode Name="16 Channel">
    <Physical>
      <Lens Name="Zoom" Degrees="25~12"/>
      <Focus Type="Head" PanMax="540" TiltMax="270"/>
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="0,1"/>
      <Attribute ID="Tilt" ChannelOffset="2,3"/>
      <Attribute ID="PTSpeed" ChannelOffset="4"/>
      <Attribute ID="Colour" ChannelOffset="5"/>
      <Attribute ID="Gobo1" ChannelOffset="6"/>
      <Attribute ID="Gobo1Rotate" ChannelOffset="7"/>
      <Attribute ID="Prism" ChannelOffset="8"/>
      <Attribute ID="Zoom" ChannelOffset="9"/>
      <Attribute ID="Shutter" ChannelOffset="10"/>
      <Attribute ID="Dimmer" ChannelOffset="11,12"/>
      <Attribute ID="Conditional"/>
    </Include>
  </Mode>
  <Mode Name="8 Channel">
